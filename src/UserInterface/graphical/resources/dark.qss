QMainWindow#cryptoDealWindow,
QWidget#windowContent {
    background-color: #12151c;
    color: #eef2f8;
}

QWidget#primarySidebar {
    background-color: #191d27;
    border-right: 1px solid #2a303d;
}

QLabel#brandLabel {
    color: #f7f9fc;
    font-size: 23px;
    font-weight: 700;
}

QLabel#brandDescription,
QLabel#navigationLabel,
QLabel#proofOfConceptLabel {
    color: #737e92;
    font-size: 10px;
    font-weight: 600;
}

QPushButton[navigation="true"] {
    background-color: transparent;
    border: 0;
    border-radius: 7px;
    color: #aeb7c7;
    font-size: 14px;
    font-weight: 500;
    padding: 0 14px;
    text-align: left;
}

QPushButton[navigation="true"]:hover {
    background-color: #222836;
    color: #f4f7fb;
}

QPushButton[navigation="true"]:checked {
    background-color: #2768d9;
    color: #ffffff;
    font-weight: 600;
}

QStackedWidget#primaryPageStack,
QWidget[primaryPage="true"] {
    background-color: #12151c;
}

QLabel[pageTitle="true"] {
    color: #f7f9fc;
    font-size: 28px;
    font-weight: 700;
}

QLabel[pageDescription="true"] {
    color: #929caf;
    font-size: 14px;
}

QWidget[placeholderCard="true"] {
    background-color: #191e28;
    border: 1px solid #2b3240;
    border-radius: 10px;
}

QWidget[orderCard="true"] {
    background-color: #191e28;
    border: 1px solid #2b3240;
    border-radius: 10px;
}

QLabel[placeholderTitle="true"] {
    color: #dbe2ed;
    font-size: 16px;
    font-weight: 600;
}

QLabel[placeholderDescription="true"] {
    color: #7f899b;
    font-size: 13px;
}

QLabel[pairCatalogStatus="true"] {
    color: #aeb7c7;
    font-size: 13px;
    padding-top: 4px;
}

QScrollArea#orderWorkspaceScrollArea,
QWidget#orderWorkspaceContent,
QWidget#orderEntryForm,
QWidget#orderPairDependentControls,
QStackedWidget#orderOperationFormStack,
QStackedWidget#orderOperationFormStack > QWidget {
    background-color: transparent;
    border: 0;
}

QLabel[selectedCatalogStatus="true"] {
    background-color: #151a23;
    border: 1px solid #2a3342;
    border-radius: 6px;
    color: #aeb7c7;
    font-size: 12px;
    padding: 8px 10px;
}

QLabel[symbolInfoStatus="true"] {
    color: #aeb7c7;
    font-size: 12px;
}

QLabel[tradingLimits="true"] {
    background-color: #151a23;
    border: 1px solid #2a3342;
    border-radius: 6px;
    color: #9da8b9;
    font-size: 12px;
    padding: 9px 10px;
}

QLabel[orderFieldLabel="true"] {
    color: #aeb7c7;
    font-size: 12px;
    font-weight: 600;
}

QLabel[operationDescription="true"] {
    color: #7f899b;
    font-size: 12px;
    padding: 3px 0;
}

QComboBox[orderInput="true"],
QLineEdit[orderInput="true"] {
    background-color: #11161f;
    border: 1px solid #323b4b;
    border-radius: 6px;
    color: #e3e9f2;
    font-size: 13px;
    padding: 0 10px;
    selection-background-color: #2768d9;
}

QComboBox[orderInput="true"]:focus,
QLineEdit[orderInput="true"]:focus {
    border-color: #4b84e6;
}

QLineEdit[orderInput="true"][validationError="true"] {
    border-color: #d45c68;
}

QComboBox[orderInput="true"]:disabled,
QLineEdit[orderInput="true"]:disabled {
    background-color: #171b23;
    border-color: #282e39;
    color: #646d7c;
}

QLineEdit[readOnlyContext="true"] {
    background-color: #202631;
    color: #9da8b9;
}

QComboBox[orderInput="true"] QAbstractItemView {
    background-color: #191f2a;
    border: 1px solid #384253;
    color: #e3e9f2;
    selection-background-color: #2768d9;
}

QCheckBox#placeOcoUseStopLimit {
    color: #c2cad7;
    font-size: 13px;
    spacing: 8px;
}

QLabel[validationError="true"] {
    color: #ef8791;
    font-size: 12px;
}

QWidget[correctionPanel="true"] {
    background-color: transparent;
}

QLabel[correctionDescription="true"] {
    color: #e2bd73;
    font-size: 12px;
}

QPushButton[secondaryOrderAction="true"] {
    background-color: #252d3b;
    border: 1px solid #3a4659;
    border-radius: 6px;
    color: #d7deea;
    font-size: 12px;
    padding: 6px 10px;
}

QPushButton[secondaryOrderAction="true"]:hover {
    background-color: #303a4b;
    border-color: #4b5a70;
}

QPushButton[primaryOrderAction="true"] {
    background-color: #2768d9;
    border: 0;
    border-radius: 6px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton[primaryOrderAction="true"]:hover {
    background-color: #3477e7;
}

QPushButton[primaryOrderAction="true"]:disabled {
    background-color: #242b37;
    color: #667184;
}

QFrame[orderFormDivider="true"] {
    border: 0;
    border-top: 1px solid #2b3240;
    max-height: 1px;
}
